{
  "name": "planner-agent",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/planner-agent/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/planner-agent"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "planner-agent:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": { "buildTarget": "planner-agent:build:development" },
        "production": { "buildTarget": "planner-agent:build:production" }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
